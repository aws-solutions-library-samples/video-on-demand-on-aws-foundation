              },
              "-HD",
        "UserMetadata": {
          "guid.$": "$.guid",
          "StackName": "",
              {
                "Ref": "AWS::StackName",
              },
              ""
        },
        "Settings": {
          "Inputs": [
            {
              "AudioSelectors": {
                "Audio Selector 1": {
                  "DefaultSelection": "DEFAULT"
                }
              },
              "VideoSelector": {
                "Rotate": "AUTO"
              },
              "FileInput.$": "$.fileUri"
            }
          ],
          "OutputGroups": [
            {
              "OutputGroupSettings": {
                "CmafGroupSettings": {
                  "Destination.$": "States.Format('s3://",
              {
